# SPDX-License-Identifier: Apache-2.0
# Optional local build accelerators. Copy this file to proxy.env when needed.
# Empty values preserve the upstream package repository and daemon pull policy.
ALPINE_MIRROR=
UBUNTU_APT_MIRROR=

# Optional digest-pinned Ubuntu image reference for the local iSecSP backend.
# Leave empty to use the version locked in versions.env.
UBUNTU_IMAGE=

# Informational only: configure this mirror in your Docker-compatible daemon.
# The project never applies it or requires the daemon to use it.
DOCKERHUB_MIRROR=
