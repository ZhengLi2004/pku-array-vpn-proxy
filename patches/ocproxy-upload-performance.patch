+static void local_read_arm(struct ocp_sock *s)
+{
+	if (vpn_output_paused) {
+		s->read_deferred = 1;
+		return;
+	}
+
+	s->read_deferred = 0;
+	if (event_add(s->ev, NULL) < 0)
+		die("can't arm local socket event\n");
+}
+
+static void vpn_set_backpressure(int enabled)
+{
+	struct ocp_sock *s;
+	int i;
+
+	if (vpn_output_paused == enabled)
+		return;
+	vpn_output_paused = enabled;
+
+	for (i = 0; i < MAX_CONN; i++) {
+		s = &ocp_sock_pool[i];
+		if (!s->in_use)
+			continue;
+
+		if (s->listener) {
+			if (enabled) {
+				if (evconnlistener_disable(s->listener) < 0)
+					die("can't pause listener\n");
+			} else if (evconnlistener_enable(s->listener) < 0)
+				die("can't resume listener\n");
+		}
+
+		if (!s->ev || s->netif)
+			continue;
+		if (enabled) {
+			if (event_pending(s->ev, EV_READ, NULL)) {
+				event_del(s->ev);
+				s->read_deferred = 1;
+			}
+		} else if (s->read_deferred) {
+			s->read_deferred = 0;
+			if (!s->lwip_blocked && event_add(s->ev, NULL) < 0)
+				die("can't resume local socket event\n");
+		}
+	}
+}
