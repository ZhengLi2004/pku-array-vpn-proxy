+static int vpn_queue_packet(struct pbuf *p, size_t total)
+{
+	struct vpn_packet *packet;
+	struct pbuf *q;
+	unsigned char *dst;
+
+	if (total > VPN_QUEUE_MAX_BYTES ||
+	    vpn_queue_bytes > VPN_QUEUE_MAX_BYTES - total) {
+		vpn_queue_overflows++;
+		LINK_STATS_INC(link.drop);
+		warn("VPN output queue overflow (%zu bytes queued)\n",
+		     vpn_queue_bytes);
+		vpn_conn_down();
+		return -1;
+	}
+
+	packet = malloc(sizeof(*packet) + total);
+	if (!packet)
+		die("out of memory queueing VPN packet\n");
+	packet->next = NULL;
+	packet->len = total;
+	dst = packet->data;
+	for (q = p; q; q = q->next) {
+		memcpy(dst, q->payload, q->len);
+		dst += q->len;
+	}
+
+	if (vpn_queue_tail)
+		vpn_queue_tail->next = packet;
+	else
+		vpn_queue_head = packet;
+	vpn_queue_tail = packet;
+	vpn_queue_bytes += total;
+	vpn_queue_packets++;
+	vpn_queue_enqueued++;
+	if (vpn_queue_bytes > vpn_queue_peak_bytes)
+		vpn_queue_peak_bytes = vpn_queue_bytes;
+
+	if (vpn_queue_bytes >= VPN_QUEUE_HIGH_WATER)
+		vpn_set_backpressure(1);
+	if (event_add(vpn_write_event, NULL) < 0)
+		die("can't arm VPN output event\n");
+	return 0;
+}
+
+static void vpn_write_cb(evutil_socket_t fd, short what, void *ctx)
+{
+	struct ocp_sock *s = ctx;
+	size_t drained = 0;
+
+	while (vpn_queue_head && drained < VPN_QUEUE_DRAIN_BYTES) {
+		struct vpn_packet *packet = vpn_queue_head;
+		ssize_t ret;
+
+		do {
+			ret = write(s->fd, packet->data, packet->len);
+		} while (ret < 0 && errno == EINTR);
+
+		if (ret < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+			break;
+		if (ret < 0) {
+			vpn_queue_errors++;
+			LINK_STATS_INC(link.drop);
+			if (errno != ECONNREFUSED && errno != ENOTCONN &&
+			    errno != EPIPE)
+				warn("VPN output retry failed: %s\n", strerror(errno));
+			vpn_conn_down();
+			return;
+		}
+		if ((size_t)ret != packet->len) {
+			vpn_queue_errors++;
+			LINK_STATS_INC(link.lenerr);
+			warn("VPN datagram was only partially written\n");
+			vpn_conn_down();
+			return;
+		}
+
+		vpn_queue_head = packet->next;
+		if (!vpn_queue_head)
+			vpn_queue_tail = NULL;
+		vpn_queue_bytes -= packet->len;
+		vpn_queue_packets--;
+		drained += packet->len;
+		vpn_queue_retried++;
+		LINK_STATS_INC(link.xmit);
+		free(packet);
+
+		if (vpn_output_paused && vpn_queue_bytes <= VPN_QUEUE_LOW_WATER)
+			vpn_set_backpressure(0);
+	}
+
+	if (vpn_queue_head && event_add(vpn_write_event, NULL) < 0)
+		die("can't rearm VPN output event\n");
+}
