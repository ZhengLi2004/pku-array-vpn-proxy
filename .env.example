# SPDX-License-Identifier: Apache-2.0
# Only non-secret runtime tuning belongs here.
# Credentials are four files under ./secrets; never put them in this file.
# init-secrets.sh maintains ARRAYVPN_UID and ARRAYVPN_GID in the local .env.
HEALTHCHECK_URL=https://its.pku.edu.cn/service_1_vpn2.jsp
HEALTHCHECK_INTERVAL=60
HEALTHCHECK_MAX_FAILS=3
HEALTHCHECK_START_TIMEOUT=180
# tls preserves the current TLS-only tunnel; auto lets OpenConnect negotiate DTLS.
VPN_DATA_TRANSPORT=tls
# A tagged release can replace only the redistributable tunnel image.
# The iSecSP authentication image must always be built locally.
# PKU_ARRAY_VPN_IMAGE=ghcr.io/zhengli2004/pku-array-vpn-proxy:v0.1.1
